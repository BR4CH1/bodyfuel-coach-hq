{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://afbiawtnqnxvaihlnmcd.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "bodyfuel-mcp",
      "version": "0.2.0",
      "title": "BODYFUEL Coaching"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Returns the signed-in BODYFUEL user's profile (name, role, goal).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "nutrition_today",
        "title": "Today's nutrition",
        "description": "Returns the signed-in user's nutrition target and consumed kcal/macros for today.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "recent_weight",
        "title": "Recent weight measurements",
        "description": "Returns the signed-in user's most recent body-weight measurements.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 14,
              "description": "How many entries to return (max 90)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "log_weight",
        "title": "Log a body-weight measurement",
        "description": "Inserts a new body-weight measurement (kg) for the signed-in user, timestamped now.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "weight_kg": {
              "type": "number",
              "minimum": 25,
              "maximum": 400,
              "description": "Body weight in kg (25–400)."
            },
            "body_fat_pct": {
              "type": "number",
              "minimum": 2,
              "maximum": 70,
              "description": "Optional body-fat percentage."
            },
            "notes": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional short note."
            }
          },
          "required": [
            "weight_kg"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "coach_business_summary",
        "title": "BodyFuel business summary",
        "description": "Read-only BodyFuel coach overview: active Coaching and Smart customers, open leads, check-ins, expiring plans, inactivity, risks, and workload.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "coach_open_tasks",
        "title": "BodyFuel open coach tasks",
        "description": "Returns prioritized read-only coach tasks from live BodyFuel Coaching data, including customer or lead names and the reason for action.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 15,
              "description": "Maximum tasks to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "coach_update_training_plan_end_date",
        "title": "Update BodyFuel training plan end date",
        "description": "Coach-only write action that changes the scheduled end date of a personal BodyFuel training plan. Performance/team plans are explicitly excluded.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "plan_id": {
              "type": "string",
              "format": "uuid",
              "description": "Training plan UUID."
            },
            "scheduled_end_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "New plan end date in YYYY-MM-DD format."
            }
          },
          "required": [
            "plan_id",
            "scheduled_end_date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "coach_reactivate_training_plan",
        "title": "Reactivate archived BodyFuel training plan",
        "description": "Coach-only write action that reactivates an archived personal BodyFuel training plan. By default it refuses to replace an existing active plan; replace_active must be set explicitly to archive and replace it.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "plan_id": {
              "type": "string",
              "format": "uuid",
              "description": "Archived training plan UUID."
            },
            "replace_active": {
              "type": "boolean",
              "default": false,
              "description": "Explicitly archive an existing active personal training plan before reactivation."
            }
          },
          "required": [
            "plan_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
